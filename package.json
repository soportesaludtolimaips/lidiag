{
    "private": true,
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "eslint \"resources/js/**/*.{js,vue}\"",
        "lint:fix": "eslint \"resources/js/**/*.{js,vue}\" --fix",
        "format": "prettier --write \"resources/js/**/*.{js,vue}\"",
        "format:check": "prettier --check \"resources/js/**/*.{js,vue}\"",
        "prepare": "simple-git-hooks"
    },
    "devDependencies": {
        "@popperjs/core": "^2.10.2",
        "@vitejs/plugin-basic-ssl": "^2.1.4",
        "@vitejs/plugin-vue": "^6.0.4",
        "axios": "^1.6.7",
        "bootstrap": "^5.2.1",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-vue": "^9.23.0",
        "laravel-vite-plugin": "^2.1.0",
        "lint-staged": "^15.2.10",
        "localtunnel": "^2.0.2",
        "lodash": "^4.17.19",
        "postcss": "^8.1.14",
        "prettier": "^3.3.3",
        "sass": "^1.32.11",
        "simple-git-hooks": "^2.11.1",
        "vite": "^7.3.1",
        "vue": "^3.2.41"
    },
    "dependencies": {
        "@ffmpeg/core": "^0.12.10",
        "@ffmpeg/ffmpeg": "^0.12.15",
        "@fullcalendar/core": "^6.1.14",
        "@fullcalendar/daygrid": "^6.1.14",
        "@fullcalendar/interaction": "^6.1.14",
        "@fullcalendar/vue3": "^6.1.14",
        "@google-cloud/speech": "^7.3.1",
        "dayjs": "^1.11.12",
        "dompurify": "^3.4.11",
        "mitt": "^3.0.1",
        "recorder-js": "^1.0.7",
        "recordrtc": "^5.6.2",
        "v-select2-component": "^0.4.7",
        "vue-bus": "^1.2.1",
        "vue-router": "^4.1.6",
        "vuetify": "^3.0.0-beta.10"
    },
    "lint-staged": {
        "resources/js/**/*.{js,vue}": [
            "eslint --fix",
            "prettier --write"
        ],
        "{app,config,database,routes}/**/*.php": [
            "php vendor/bin/pint"
        ]
    },
    "simple-git-hooks": {
        "pre-commit": "npx lint-staged"
    }
}
