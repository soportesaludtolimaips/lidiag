APP_NAME=LIDiag
APP_ENV=local
APP_KEY=base64:your-base64-app-key-here
APP_DEBUG=true
APP_URL=https://lidiag.test
=
# Sanctum (SPA / stateful): permite que /api/* use la sesión (cookies)
SANCTUM_STATEFUL_DOMAINS=lidiag.test,lidiag.test:443,lidiag.com,lidiag.com:443
=
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
=
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lidiag
DB_USERNAME=root
DB_PASSWORD=
=
DB_CONNECTION=mysql
DB_HOST_2=10.35.47.3
DB_PORT_2=3306
DB_DATABASE_2=pacsdb
DB_USERNAME_2=your-pacs-db-username
DB_PASSWORD_2=your-pacs-db-password
=
DB_CONNECTION_IMPORTAR=mysql
DB_HOST_IMPORTAR=127.0.0.1
DB_PORT_IMPORTAR=3306
DB_DATABASE_IMPORTAR=ecografias_personal
DB_USERNAME_IMPORTAR=root
DB_PASSWORD_IMPORTAR=
=
DB_CONNECTION_SQLSRV=sqlsrv
DB_HOST_SQLSRV=172.16.5.6
DB_PORT_SQLSRV=1433
DB_DATABASE_SQLSRV=ESP_PRI
DB_USERNAME_SQLSRV=your-sqlsrv-username
DB_PASSWORD_SQLSRV=your-sqlsrv-password
=
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=
=
MEMCACHED_HOST=127.0.0.1
=
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
=
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="your-email@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"
=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
=
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1
=
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_DEV_SERVER_KEY='C:/laragon/etc/ssl/laragon.key'
VITE_DEV_SERVER_CERT='C:/laragon/etc/ssl/laragon.crt'
=
URL_API_REPORTES = https://10.35.47.5
=
API_HMAC_SECRET = 'your-api-hmac-secret-here'
TELERADIOLOGIA_HMAC_SECRET='your-tele-radiologia-hmac-secret-here'
=
# Meta WhatsApp API
META_WHATSAPP_TOKEN=your-meta-whatsapp-token
META_WHATSAPP_PHONE_ID=your-phone-id
META_WHATSAPP_APP_SECRET=your-app-secret
META_WHATSAPP_BUSINESS_ID=your-business-id
=
# Servicio de Transcripcion de Audio
TRANSCRIPTOR_SERVICE_URL=http://localhost:8001
TRANSCRIPTOR_TIMEOUT=300
META_WHATSAPP_VERIFY_TOKEN=your-verify-token
SESSION_SECURE_COOKIE=
=
# Backups Automaticos
BACKUP_DESTINATION_PATH=C:\Backups_Lidiag
BACKUP_RETENTION_DAYS=30
MYSQLDUMP_PATH=
BACKUP_DCM_DESTINATION_PATH=C:\Backups_Lidiag\dcm_sedes
BACKUP_DCM_RETENTION_DAYS=30
