APP_NAME=LIDiag
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://lidiag.test

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lidiag
DB_USERNAME=root
DB_PASSWORD=

# Secundaria (si aplica)
DB_DATABASE_2=
DB_USERNAME_2=
DB_PASSWORD_2=

# Importar (si aplica)
DB_CONNECTION_IMPORTAR=
DB_HOST_IMPORTAR=
DB_PORT_IMPORTAR=
DB_DATABASE_IMPORTAR=
DB_USERNAME_IMPORTAR=
DB_PASSWORD_IMPORTAR=

# HIS/SAHI (SQL Server) - placeholders (NO credenciales reales)
DB_CONNECTION_SQLSRV=sqlsrv
DB_HOST_SQLSRV=
DB_PORT_SQLSRV=1433
DB_DATABASE_SQLSRV=
DB_USERNAME_SQLSRV=
DB_PASSWORD_SQLSRV=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail - placeholders
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Vite dev server certs (si no usas rutas hardcode en vite.config.js)
VITE_DEV_SERVER_KEY=
VITE_DEV_SERVER_CERT=

# Twilio (WhatsApp) - placeholders
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Tele Radiología (TLIMAGEN) - placeholders
TELERADIOLOGIA_ORDEN_URL=https://ris.tlimagen.com/RISServices/integracion/salud_tolima/ordenes
TELERADIOLOGIA_RESULTADOS_URL=https://ris.tlimagen.com/RISServices/integracion/salud_tolima/resultados
TELERADIOLOGIA_TIMEOUT=30
TELERADIOLOGIA_RETRIES=1


# Servicio externo de reportes - placeholders
URL_API_REPORTES = https://10.35.47.5

